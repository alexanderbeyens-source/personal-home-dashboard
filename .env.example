# Local OAuth app callback: http://localhost:5173/api/auth/callback/github
AUTH_URL=http://localhost:5173
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_ID=

# Weather location. These values are server-only and are not sent to the browser.
WEATHER_LAT=50.9894
WEATHER_LON=5.0506
WEATHER_LOCATION=Diest

# Optional private integrations; keep their values in .env or Render's secret settings.
# Several calendars (e.g. iCloud "Public Calendar" links); takes precedence over CALENDAR_ICS_URL.
# CALENDAR_ICS_URLS=[{"name":"Gezin","url":"webcal://<placeholder>","color":"#4f8cff"},{"name":"Werk","url":"webcal://<placeholder>"}]
# CALENDAR_ICS_URL=
# HOME_ASSISTANT_URL=
# HOME_ASSISTANT_TOKEN=
# PROJECTS_JSON=[{"name":"Portfolio","url":"https://example.com","description":"Personal site"}]
# Task list in a private GitHub repo: fine-grained token with Contents read/write on that repo only.
# GITHUB_TASKS_TOKEN=<fine-grained-token>
# GITHUB_TASKS_REPO=<owner>/<repo>
# GITHUB_TASKS_PATH=tasks.md
# Garmin health data via intervals.icu (Settings > Developer settings > API key).
# INTERVALS_ATHLETE_ID=<athlete-id>
# INTERVALS_API_KEY=<api-key>
# Duolingo streak/XP from a public profile (unofficial endpoint, no password or token).
# DUOLINGO_USERNAME=<username>
# Mercedes-Benz via Smartcar (read-only, Smartcar Free plan). Client ID and secret from the
# Smartcar dashboard (API Credentials); the redirect URI must be AUTH_URL + /api/smartcar/callback.
# SMARTCAR_CLIENT_ID=
# SMARTCAR_CLIENT_SECRET=
# SMARTCAR_REDIRECT_URI=
